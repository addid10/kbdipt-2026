DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
DATABASE_URL=postgresql://kbdipt:change-me@db:5432/kbdipt
POSTGRES_PASSWORD=change-me
VEGETATION_MODEL_PATH=/app/backend/kbdiproject/model_weights/vegetation_shufflenet_v2_epoch75.pkl

# Enable these after HTTPS/TLS is configured in front of Nginx.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_HSTS_SECONDS=0
